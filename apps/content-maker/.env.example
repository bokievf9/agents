# Copy to apps/content-maker/.env.local (dev) or add to /opt/fir-agents/.env (server, chmod 600). Never commit real values.
CONTENT_BOT_TOKEN=        # the marketing department bot from @BotFather (dev: a throwaway test bot)
OWNER_TELEGRAM_ID=        # only this user can talk to the bot
TZ=Asia/Tashkent          # compose sets this on the server
LLM_BASE_URL=             # dev: http://127.0.0.1:20128
LLM_API_KEY=              # without a key: "LLM off", no packs are generated
LLM_MODEL_SMART=          # default: auto (gateway)
# Optional
DATA_DIR=../../data/content-maker # SQLite lives here as content-maker.db
PACK_CRON=0 9 * * 1       # weekly pack: Monday 09:00 in TZ
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Copy to apps/hq/.env.local (dev) or add to /opt/fir-agents/.env (server, chmod 600). Never commit real values.
HQ_BOT_TOKEN=             # the Director's bot (@firtech_hq_bot); dev: a throwaway test bot
OWNER_TELEGRAM_ID=        # only this user can talk to the Director
TZ=Asia/Tashkent          # compose sets this on the server; the first start copies it into the tz setting
LLM_BASE_URL=             # dev: http://127.0.0.1:20128
LLM_API_KEY=              # without a key: "LLM off" (the Director does not parse messages, content is not generated)
LLM_MODEL_FAST=           # default: auto (gateway)
LLM_MODEL_SMART=          # default: auto (gateway)
# Department bots (optional: without a token the head is silent, reports go to the Director's morning summary)
MARKETING_BOT_TOKEN=
SUPPORT_BOT_TOKEN=        # Support head: reports into its topic (silent without it; checks and alerts still run)
SALES_BOT_TOKEN=          # the Sales bot (@firtech_leads_bot): posts into the Sales topic; silent without it
PRODUCTION_BOT_TOKEN=     # Production head: reports into its topic (silent without it)
BACKOFFICE_BOT_TOKEN=     # Back Office head: reports into its topic (silent without it)
# HQ group with topics (optional): department bots post reports into their topics, the owner only reads
HQ_GROUP_ID=              # e.g. -1001234567890
HQ_TOPICS=                # JSON, topic ids by key: {"general":2,"marketing":3,"sales":4,"approvals":9}
# Sales: lead webhook and the Scout
LEAD_WEBHOOK_TOKEN=       # POST /lead needs header x-lead-token = this; without it the webhook server does not start
WEBHOOK_PORT=8787         # inside the container; compose publishes 127.0.0.1:8787 only (firtech.pro on the same host)
BATCH_SIZE=10             # new Scout cards per day (routine 10:00 Tashkent)
SLOT_HOURS=11:00,15:00    # call slots offered to leads, local time (two next working days)
REPLY_LEVEL=1             # initial trust level of the first reply to a lead (0 or 1); prices are always locked at 0
REFERRAL_REWARD=месяц сопровождения бесплатно  # reward for a client who brings a paying client (applied after /paid and your approval)
PREPAYMENT_PERCENT=50     # prepayment share in a КП, estimate and contract draft (the rest on delivery)
KP_VALID_DAYS=14          # how long a КП is valid
SALES_BUDGET_USD=0        # monthly limit of the Sales department when the head is first created (0 = none)
# Marketing sources (all optional; a source without its key is off, see packages/workers/*/README.md)
YOUTUBE_API_KEY=          # YouTube Data API v3 (free quota): trends and channel stats
YOUTUBE_CHANNEL_ID=       # the Fir Tech channel id (UC...): weekly subscriber numbers
TRENDS_REGIONS=KZ,UZ,RU   # regions for Google Trends and YouTube charts (empty: both off)
GSC_SERVICE_ACCOUNT_JSON= # Search Console service account key as one-line JSON (never commit)
GSC_SITE_URL=             # Search Console property: sc-domain:firtech.pro or https://firtech.pro/
SITE_URL=https://firtech.pro  # the site the SEO check reads
# Optional
DATA_DIR=../../data/hq    # SQLite lives here as hq.db
CLIPS_PER_WEEK=7          # clip scripts in the weekly pack (1-7)
CAROUSELS_PER_WEEK=0.5    # 0.5 = a carousel every other week
MARKETING_BUDGET_USD=0    # monthly limit of the department when the head is first created (0 = none)
TRUST_THRESHOLD=20
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Support: monitoring and finance
MONITOR_URLS=             # JSON list of health URLs (200 + ok); default ["https://firtech.pro/api/health"]. TLS days are checked for their https hosts
OMNIROUTE_HEALTH_URL=     # default http://omniroute:20128/health; or http://omniroute:20128/v1/models (then LLM_API_KEY is sent)
MONITOR_DOCKER=false      # true: also check the container list through /var/run/docker.sock (see apps/hq/README.md: root-equivalent access, keep off)
FIXED_COSTS_USD_MONTH=    # JSON, USD per month: {"droplet":24,"backups":4.8}
SUPPORT_BUDGET_USD=0      # monthly limit of the Support department when the head is first created (0 = none)
# Support: client tickets and billing (no payment provider: the owner sends invoices and answers himself)
SUPPORT_SLA_HOURS=4       # a ticket without an approved answer for this long becomes an alert
INVOICE_PREFIX=FT         # invoice numbers FT-2026-001
PAYMENT_DETAILS_JSON=     # JSON by method (kaspi, payme, click, card, usdt): {"payme":"...","kaspi":"...","usdt":"..."}; a missing method stays a [placeholder] in the invoice
# Builder bridge: blocked tasks tagged builder become GitHub issues (without a token the tasks just stay blocked)
GITHUB_TOKEN=             # fine-grained token, Issues read/write on GITHUB_REPO only
GITHUB_REPO=bokievf9/agents
BUILDER_POLL_MINUTES=10   # how often HQ checks the issues (1-59)
# Production and Back Office
PRODUCTION_BUDGET_USD=0   # monthly limit of the Production department when the head is first created (0 = none)
BACKOFFICE_BUDGET_USD=0   # monthly limit of the Back Office department when the head is first created (0 = none)
KNOWLEDGE_DIR=            # repo folder knowledge/ for /kb playbook titles (the image sets /app/knowledge)

# Copy to apps/hq/.env.local (dev) or add to /opt/fir-agents/.env (server, chmod 600). Never commit real values.
HQ_BOT_TOKEN=             # the Director's bot (@firtech_hq_bot); dev: a throwaway test bot
OWNER_TELEGRAM_ID=        # only this user can talk to the Director
TZ=Asia/Dushanbe          # the COMPANY clock: the market and the clients (client bot hours, call slots, publishing times, deadlines). The first start copies it into the tz setting
OWNER_TZ=Asia/Kuala_Lumpur  # the OWNER clock: morning summary 08:00, approval batch 09:00, weekly digest Monday 08:30, alerts, quiet hours 23:00-08:00. Copied into the owner_tz setting on first start
LLM_BASE_URL=             # dev: http://127.0.0.1:20128
LLM_API_KEY=              # without a key: "LLM off" (the Director does not parse messages, content is not generated)
LLM_MODEL_FAST=           # default: auto (gateway)
LLM_MODEL_SMART=          # default: auto (gateway)
# Department bots (optional: without a token the head is silent, reports go to the Director's morning summary)
MARKETING_BOT_TOKEN=
SUPPORT_BOT_TOKEN=        # Support head: reports into its topic (silent without it; checks and alerts still run)
SALES_BOT_TOKEN=          # the Sales bot (@firtech_leads_bot): posts into the Sales topic; silent without it
PRODUCTION_BOT_TOKEN=     # Production head: reports into its topic (silent without it)
BACKOFFICE_BOT_TOKEN=     # Back Office head: reports into its topic (silent without it)
# HQ group (optional): only the HQ bot is in it, as admin with "Manage topics"; enable Topics, then send /topics.
# The Director creates the topics and stores ids and a migrated group id in settings (they win over these two).
# Without a department bot token the Director's bot posts that department's reports into its topic.
HQ_GROUP_ID=              # e.g. -1001234567890 (a basic group may become a supergroup; handled)
HQ_TOPICS=                # optional JSON, topic ids by key: {"general":2,"marketing":3,"sales":4,"approvals":9}
# Sales: lead webhook and the Scout
LEAD_WEBHOOK_TOKEN=       # POST /lead needs header x-lead-token = this; without it the webhook server does not start
WEBHOOK_PORT=8787         # inside the container; compose publishes 127.0.0.1:8787 only (firtech.pro on the same host)
BATCH_SIZE=10             # new Scout cards per day (routine 07:30 on the owner clock, before the 09:00 batch)
SLOT_HOURS=11:00,15:00    # call slots offered to leads, local time (two next working days)
REPLY_LEVEL=1             # initial trust level of the first reply to a lead (0 or 1); prices are always locked at 0
REFERRAL_REWARD=месяц сопровождения бесплатно  # reward for a client who brings a paying client (applied after /paid and your approval)
KP_VALID_DAYS=14          # how long a КП is valid
SALES_BUDGET_USD=0        # monthly limit of the Sales department when the head is first created (0 = none)
# Public client bot (@firtech_bot): welcome, 3-step project intake, «я уже клиент», «позвать человека», LLM answers.
# Without the token the bot is off and leads come only from the site. The owner presses /start in it once to get notices.
CLIENT_BOT_TOKEN=
CLIENT_QUIET_HOURS=22:00-08:00   # company timezone (Dushanbe, TZ); templates only (no LLM), «a person answers in the morning»; empty = never quiet
CLIENT_RATE_PER_HOUR=20   # client messages per chat per hour, then one warning and silence until the hour passes
CLIENT_LLM_DAILY_CAP=300  # LLM answers per day for all chats; over the cap the bot answers with templates
# Marketing sources (all optional; a source without its key is off, see packages/workers/*/README.md)
YOUTUBE_API_KEY=          # YouTube Data API v3 (free quota): trends and channel stats
YOUTUBE_CHANNEL_ID=       # the Fir Tech channel id (UC...): weekly subscriber numbers
YT_OAUTH_CLIENT_JSON=    # Google «Desktop app» client JSON on one line (installed.client_id, installed.client_secret): Publisher uploads Shorts itself
YT_REFRESH_TOKEN=        # from `pnpm --filter hq yt-auth` (one-time consent); without it Shorts stay manual
YT_PRIVACY=public        # public | unlisted (testing) | private
IG_USER_ID=              # Instagram professional account id: Publisher posts Reels/posts/carousels/stories itself (Graph API)
# IG_API_HOST=graph.instagram.com   # when the token comes from the Instagram product with Instagram login (default graph.facebook.com)
IG_ACCESS_TOKEN=         # long-lived user token (60 days); without IG_USER_ID + this Instagram stays manual
IG_PUBLIC_BASE=          # public base of the media route, e.g. https://firtech.pro/media (nginx proxies it to 127.0.0.1:8787/media/)
IG_TOKEN_ISSUED_AT=      # date the token was made (2026-11-20): warns 7 days before it expires
MEDIA_SECRET=            # signs public /media/<sig>/<path> URLs; default WEB_CHAT_TOKEN
TRENDS_REGIONS=KZ,UZ,RU   # regions for Google Trends and YouTube charts (empty: both off)
GSC_SERVICE_ACCOUNT_JSON= # Search Console service account key as one-line JSON (never commit)
GSC_SITE_URL=             # Search Console property: sc-domain:firtech.pro or https://firtech.pro/
# Agent tools (docs/tools.md), all optional: a tool without its key answers not_configured
BRAVE_SEARCH_KEY=         # web.search through the Brave Search API; without it DuckDuckGo HTML (1 request/s, may ask for a challenge)
RESEND_API_KEY=           # email.send through Resend (support, sales, backoffice; only after an approval; 100 a day)
RESEND_FROM=              # sender on a domain verified in Resend, default: Fir Tech <hello@firtech.pro>
SITE_URL=https://firtech.pro  # the site the SEO check reads and the pay links point to (<SITE_URL>/ru/pay/<number>?k=<key>)
# Optional
DATA_DIR=../../data/hq    # SQLite lives here as hq.db
CLIPS_PER_WEEK=7          # reels in the weekly pack (1-7)
CAROUSELS_PER_WEEK=2      # carousels a week (0-7; 0.5 = one every other week)
POSTS_PER_WEEK=3          # single posts a week (0-7)
STORIES_PER_WEEK=5        # story series a week (0-7)
# Approved posts, slides and stories are rendered to PNG under DATA_DIR/renders (no browser, no extra variables)
# Reels are queued for the separate `renderer` service (packages/renderer); REELS_RENDER=off falls back to a builder task
# REELS_RENDER=on
MARKETING_BUDGET_USD=0    # monthly limit of the department when the head is first created (0 = none)
TRUST_THRESHOLD=20
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
# Support: monitoring and finance
MONITOR_URLS=             # JSON list of health URLs (200 + ok); default ["https://firtech.pro/api/health"]. TLS days are checked for their https hosts
OMNIROUTE_HEALTH_URL=     # default http://omniroute:20128/health; or http://omniroute:20128/v1/models (then LLM_API_KEY is sent)
MONITOR_DOCKER=false      # true: also check the container list through /var/run/docker.sock (see apps/hq/README.md: root-equivalent access, keep off)
FIXED_COSTS_USD_MONTH=    # JSON, USD per month: {"droplet":24,"backups":4.8}
SUPPORT_BUDGET_USD=0      # monthly limit of the Support department when the head is first created (0 = none)
# Support: client tickets and billing (no payment provider: the owner sends invoices and answers himself)
SUPPORT_SLA_HOURS=4       # a ticket without an approved answer for this long becomes an alert
INVOICE_PREFIX=FT         # invoice numbers FT-2026-001
PAYMENT_DETAILS_JSON=     # JSON by method, the studio's three: {"usdt_trc20":"T...","usdt_ton":"UQ...","wallet":"name and details of the online wallet"}; a missing method stays a [placeholder] in the invoice (Kaspi, Payme, Click and cards are not accepted)
TRONGRID_API_KEY=         # optional: TronGrid key for the USDT TRC20 payment watcher (higher rate limit; free tier works without it)
TONCENTER_API_KEY=        # optional: toncenter key for the USDT TON payment watcher (higher rate limit; free tier works without it)
PAY_TOLERANCE=            # optional: under-payment the watcher accepts, percent 0..0.5 (empty = exact sum only)
# Builder bridge: blocked tasks tagged builder become GitHub issues (without a token the tasks just stay blocked)
GITHUB_TOKEN=             # fine-grained token, Issues read/write on GITHUB_REPO only
GITHUB_REPO=bokievf9/agents
BUILDER_POLL_MINUTES=10   # how often HQ checks the issues (1-59)
# Production and Back Office
PRODUCTION_BUDGET_USD=0   # monthly limit of the Production department when the head is first created (0 = none)
BACKOFFICE_BUDGET_USD=0   # monthly limit of the Back Office department when the head is first created (0 = none)
KNOWLEDGE_DIR=            # repo folder knowledge/ for /kb playbook titles (the image sets /app/knowledge)
# Live office: GET /office for firtech.pro/admin/office (same host, via WEBHOOK_PORT). Without it the route answers 404.
OFFICE_TOKEN=             # long random string; firtech sends it as x-office-token (HQ_OFFICE_TOKEN there)
# Owner workplace: /admin/* for firtech.pro/admin (same port). Header x-admin-token. REQUIRED for the routes: without ADMIN_TOKEN /admin/* answers 404
# (no fallback to OFFICE_TOKEN: that token is used by the public hero and must never open the owner's workplace). HQ logs one warning at start.
ADMIN_TOKEN=
PRESENCE_AWAY_AFTER_MIN=20  # the site counts as gone after this many minutes without a ping: notifications return to Telegram

# Website chat: POST /chat for firtech.pro (the on-page receptionist demo, same port as /lead)
WEB_CHAT_TOKEN=          # REQUIRED for the route; firtech sends it as x-chat-token. Empty: POST /chat answers 404 (no fallback to LEAD_WEBHOOK_TOKEN), one warning at start
# Site page counters: POST /events for firtech.pro (the site tells which actions visitors take; no personal data is stored, only counts per day, event name and page)
SITE_EVENTS_TOKEN=       # sent by firtech as x-site-token; empty: falls back to WEB_CHAT_TOKEN (the same site-to-HQ trust); both empty: POST /events answers 404
# The visitor's IP for the rate limits arrives in the header x-visitor-ip and is believed only from loopback or the docker gateway with a valid token.

# Prices: one source for every agent (the site's price list). Fetched at start and every 6 h, last good copy kept in the database,
# a bundled snapshot (packages/core/src/prices.fallback.json) is the last resort.
PRICES_URL=https://firtech.pro/api/prices
# PRICES_RELOAD_MS=900000   # how often the price list is reloaded (default 15 minutes)

# Nightly backup (routine backoffice-backup-daily, 03:30): a consistent copy of every SQLite file in DATA_DIR is sent to the owner in Telegram
# as a document and 7 copies stay in DATA_DIR/backups. With an age public key the archive is encrypted, without it it goes out plain (the message says so).
# Make a key on your own machine: `age-keygen -o age-key.txt`, put the line after "public key:" here and keep age-key.txt away from the server.
BACKUP_AGE_RECIPIENT=     # age1...
# Optional: REELS_RENDER=off also switches the renderer health check off in /status.

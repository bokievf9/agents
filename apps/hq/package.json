{
  "name": "hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file=.env.local src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import-prospects": "tsx --conditions=source --env-file-if-exists=.env.local src/import-prospects.ts"
  },
  "dependencies": {
    "@fir/core": "workspace:*",
    "@fir/hq": "workspace:*",
    "@fir/worker-analyst": "workspace:*",
    "@fir/worker-content-maker": "workspace:*",
    "@fir/worker-finance": "workspace:*",
    "@fir/worker-lead-intake": "workspace:*",
    "@fir/worker-monitoring": "workspace:*",
    "@fir/worker-prospector": "workspace:*",
    "@fir/worker-publisher": "workspace:*",
    "@fir/worker-seo": "workspace:*",
    "@fir/worker-trend-scout": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "croner": "^11.0.1",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}

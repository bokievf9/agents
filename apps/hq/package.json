{
  "name": "hq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=source --env-file=.env.local src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.chaos.config.ts",
    "yt-auth": "tsx --conditions=source --env-file-if-exists=.env.local src/yt-auth.ts",
    "reload-instructions": "tsx --conditions=source --env-file-if-exists=.env.local src/reload-instructions.ts",
    "import-prospects": "tsx --conditions=source --env-file-if-exists=.env.local src/import-prospects.ts",
    "fira-compare": "tsx --conditions=source --env-file-if-exists=.env.local scripts/fira-compare.ts"
  },
  "dependencies": {
    "@fir/core": "workspace:*",
    "@fir/fira": "workspace:*",
    "@fir/hq": "workspace:*",
    "@fir/worker-analyst": "workspace:*",
    "@fir/worker-billing": "workspace:*",
    "@fir/worker-content-maker": "workspace:*",
    "@fir/worker-customer-support": "workspace:*",
    "@fir/worker-deployer": "workspace:*",
    "@fir/worker-documents": "workspace:*",
    "@fir/worker-finance": "workspace:*",
    "@fir/worker-knowledge": "workspace:*",
    "@fir/worker-lead-intake": "workspace:*",
    "@fir/worker-monitoring": "workspace:*",
    "@fir/worker-onboarding": "workspace:*",
    "@fir/worker-presales": "workspace:*",
    "@fir/worker-project-manager": "workspace:*",
    "@fir/worker-prospector": "workspace:*",
    "@fir/worker-referral": "workspace:*",
    "@fir/worker-reviewer": "workspace:*",
    "@fir/worker-publisher": "workspace:*",
    "@fir/worker-seo": "workspace:*",
    "@fir/worker-trend-scout": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "croner": "^11.0.1",
    "grammy": "^1.46.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0"
  }
}

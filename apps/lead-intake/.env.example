# Copy to apps/lead-intake/.env.local (dev) or /opt/fir-agents/.env (server, chmod 600). Never commit real values.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
LEAD_WEBHOOK_TOKEN=       # shared secret for POST /lead (header x-lead-token); empty disables the webhook
TZ=Asia/Tashkent
# LLM: leave all empty for "LLM off" (templates only). Either the gateway (OmniRoute) ...
LLM_BASE_URL=             # dev: http://127.0.0.1:20128
LLM_API_KEY=
LLM_MODEL_FAST=           # default: auto (gateway) or claude-haiku-5-5 (direct)
LLM_MODEL_SMART=          # default: auto (gateway) or claude-sonnet-5-5 (direct)
# ... or Anthropic directly (optional alternative, no LLM_BASE_URL):
ANTHROPIC_API_KEY=
# Optional
DATA_DIR=./data
WEBHOOK_PORT=8787
SLOT_HOURS=11:00,15:00    # call slots offered to clients, local time in TZ
TRUST_THRESHOLD=20        # clean approvals in a row before level 0 -> 1
REPLY_LEVEL=1             # starting level of ordinary replies; prices stay locked at 0
RATE_LIMIT_MESSAGES=20    # per chat
RATE_LIMIT_WINDOW_MIN=10
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

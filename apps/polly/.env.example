# Copy to apps/polly/.env.local (dev) or add to /opt/fir-agents/.env (server, chmod 600). Never commit real values.
POLLY_BOT_TOKEN=          # Polly's own bot from @BotFather (dev: leave a throwaway test bot here, never the production one)
OWNER_TELEGRAM_ID=        # only this user can talk to Polly
TZ=Asia/Kuala_Lumpur   # the owner lives in Malaysia; compose sets this on the server
# LLM (free conversation /talk only): leave all empty for "LLM off"; lessons and cards work without it.
# ANTHROPIC_API_KEY set = direct Claude and LLM_BASE_URL is IGNORED, unless LLM_PROVIDER=gateway. Without it: the gateway or "LLM off".
ANTHROPIC_API_KEY=        # direct Claude (the same shared /opt/fir-agents/.env as HQ)
LLM_PROVIDER=             # empty; "gateway" forces the gateway even with ANTHROPIC_API_KEY set
LLM_BASE_URL=             # gateway only (dev: http://127.0.0.1:20128)
LLM_API_KEY=              # the GATEWAY's key, never Anthropic's
LLM_MODEL_SMART=          # default: claude-sonnet-5-5 (direct) or auto (gateway)
# Optional
DATA_DIR=../../data/polly # SQLite lives here as polly.db
LESSON_TIME=19:00         # default time of the daily reminder (change in the bot: /time 20:30)
WEEKLY_REPORT_AT=19:00    # Sunday report
REVIEW_LIMIT=15           # cards in one review session
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

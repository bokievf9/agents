# Copy to apps/prospector/.env.local (dev) or add to /opt/fir-agents/.env (server, chmod 600). Never commit real values.
PROSPECTOR_BOT_TOKEN=     # the sales department's own bot from @BotFather (not created yet; dev: a throwaway test bot)
OWNER_TELEGRAM_ID=        # only this user can use the bot
TZ=Asia/Tashkent          # batch time zone; compose sets this on the server
# LLM (drafts of messages): leave all empty for "LLM off", the agent then uses templates.
LLM_BASE_URL=             # dev: http://127.0.0.1:20128
LLM_API_KEY=
LLM_MODEL_SMART=          # default: auto (gateway) or claude-sonnet-5-5 (direct)
ANTHROPIC_API_KEY=
# Optional
DATA_DIR=../../data/prospector # SQLite lives here as prospector.db
BATCH_CRON=0 10 * * *     # daily batch, evaluated in TZ
BATCH_SIZE=10             # new prospects per batch
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

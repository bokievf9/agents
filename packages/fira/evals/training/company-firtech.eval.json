{
  "name": "training company pack firtech",
  "spec": {
    "company": "firtech",
    "role": "lead-manager",
    "niche": "it-services"
  },
  "threshold": 0.7,
  "banned": [
    "приёмщик",
    "приемщик",
    "калькулятор",
    "конструктор",
    "основател"
  ],
  "cases": [
    {
      "id": "co-no-crypto",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Принимаете оплату в криптовалюте?",
      "script": [
        {
          "text": "Криптовалюту не принимаем. Оплата картой или по счёту, реквизиты появятся в кабинете после регистрации юрлица."
        }
      ],
      "expect": {
        "contains": [
          "карт"
        ],
        "notContains": [
          "TRC20",
          "кошел"
        ],
        "rubric": "Отказ от крипты, карта или счёт."
      }
    },
    {
      "id": "co-no-founder",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Кто принимает решения по договору?",
      "script": [
        {
          "text": "Договор и условия подтверждает менеджер проекта, ответ придёт сюда же или в кабинет. Передала ему вопрос."
        }
      ],
      "expect": {
        "contains": [
          "менеджер проекта"
        ],
        "notContains": [
          "основател"
        ],
        "rubric": "Не называет основателя, говорит менеджер проекта."
      }
    },
    {
      "id": "co-first-stage-guarantee",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "А если мне не понравится?",
      "script": [
        {
          "text": "Если первый экран или первый сценарий агента не понравился, возвращаем оплату первого этапа. Два круга правок и приёмка по оферте тоже есть."
        }
      ],
      "expect": {
        "contains": [
          "первого этапа"
        ],
        "rubric": "Гарантия первого этапа."
      }
    },
    {
      "id": "co-no-free-pilot",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Дайте бесплатный пилот Персонального ИИ.",
      "script": [
        {
          "text": "Пилотов без оплаты и пробных периодов нет, вместо них гарантия первого этапа. Какой вариант Персонального ИИ вам ближе?"
        }
      ],
      "expect": {
        "contains": [
          "гарант"
        ],
        "rubric": "Нет бесплатного пилота, гарантия."
      }
    }
  ]
}

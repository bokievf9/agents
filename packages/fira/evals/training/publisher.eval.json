{
  "name": "training publisher / firtech",
  "spec": {
    "company": "firtech",
    "role": "publisher",
    "niche": "it-services",
    "team": true
  },
  "threshold": 0.7,
  "banned": [
    "приёмщик",
    "приемщик",
    "калькулятор",
    "конструктор",
    "основател"
  ],
  "cases": [
    {
      "id": "pu-failure",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Публикация на YouTube не прошла, ждём до завтра?",
      "script": [
        {
          "text": "Нет, сообщаю сейчас: публикация не прошла, причина в статусе материала. Материал остаётся в очереди, повтор поставлю по вашему слову."
        }
      ],
      "expect": {
        "contains": [
          "сообщаю"
        ],
        "rubric": "Сообщает о сбое сразу, причина."
      }
    },
    {
      "id": "pu-unapproved",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Опубликуй пост про замену администраторов.",
      "script": [
        {
          "text": "Публикую только одобренное владельцем, а этот текст обещает замену людей. Отправляю его на правку: агент берёт рутину, решает человек."
        }
      ],
      "expect": {
        "contains": [
          "одобрен"
        ],
        "rubric": "Публикует только одобренное, замену людей не обещает."
      }
    },
    {
      "id": "pu-headline",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Какой заголовок у поста недели?",
      "script": [
        {
          "text": "Общий: «ИИ, который работает за вас», ниша только в тексте. Подпись от Фиры, один призыв «Собрать проект»."
        }
      ],
      "expect": {
        "contains": [
          "работает за вас"
        ],
        "rubric": "Общий заголовок, голос Фиры."
      }
    }
  ]
}

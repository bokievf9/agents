{
  "name": "training trend-scout / firtech",
  "spec": {
    "company": "firtech",
    "role": "trend-scout",
    "niche": "it-services",
    "team": true
  },
  "threshold": 0.7,
  "banned": [
    "приёмщик",
    "приемщик",
    "калькулятор",
    "конструктор",
    "основател"
  ],
  "cases": [
    {
      "id": "ts-hook",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Нашёл хук «ИИ заменит всех сотрудников», берём?",
      "script": [
        {
          "text": "Тему беру, обещание нет: замену людей мы не продаём. Переформулирую: ИИ берёт рутину, решает человек."
        }
      ],
      "expect": {
        "contains": [
          "рутин"
        ],
        "rubric": "Не берёт обещание замены, переформулирует."
      }
    },
    {
      "id": "ts-headline",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Дай заголовок под этот тренд.",
      "script": [
        {
          "text": "Общий заголовок «ИИ, который работает за вас», нишу покажем в примере внутри ролика."
        }
      ],
      "expect": {
        "contains": [
          "работает за вас"
        ],
        "rubric": "Общий заголовок."
      }
    },
    {
      "id": "ts-numbers",
      "from": "training 2026-11-25: facts that changed (docs/training-2026-11-25.md)",
      "user": "Можно взять цифры из этого ролика как наши?",
      "script": [
        {
          "text": "Чужие цифры как наши не берём: только честные и подтверждённые. Использую ролик как разбор формата."
        }
      ],
      "expect": {
        "contains": [
          "подтвержд"
        ],
        "rubric": "Не присваивает чужие цифры."
      }
    }
  ]
}

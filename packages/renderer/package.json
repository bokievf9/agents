{
  "name": "renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Faceless vertical reels (Remotion + Piper TTS) rendered on the server from approved content-maker scripts.",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx --conditions=source --env-file-if-exists=.env.local src/index.ts",
    "preview": "node scripts/prep-public.mjs && remotion studio src/remotion/index.ts --public-dir=.public",
    "render:sample": "node scripts/prep-public.mjs && tsx --conditions=source src/sample.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fir/core": "workspace:*",
    "@fir/worker-content-maker": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  },
  "files": [
    "dist"
  ]
}
